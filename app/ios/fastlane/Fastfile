default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Fetch provisioning profiles and certificates automatically using match
    # match(type: "appstore")
    
    # Build iOS app using Flutter
    sh("cd ../.. && flutter build ipa --release --obfuscate --split-debug-info=build/ios/symbols")

    # Upload to TestFlight
    upload_to_testflight(
      ipa: '../build/ios/ipa/ngo_volunteer_app.ipa',
      skip_waiting_for_build_processing: true
    )
  end

  desc "Run automated UI tests, capture screenshots and build for App Store"
  lane :release do
    # Run tests
    sh("cd ../.. && flutter test")

    # Capture screenshots
    # snapshot

    # Build iOS app
    sh("cd ../.. && flutter build ipa --release --obfuscate --split-debug-info=build/ios/symbols")

    # Upload to App Store
    upload_to_app_store(
      ipa: '../build/ios/ipa/ngo_volunteer_app.ipa',
      submit_for_review: false
    )
  end
end
